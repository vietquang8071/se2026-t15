POSTGRES_DB=meeting_minutes_dev
POSTGRES_USER=meeting_minutes
POSTGRES_PASSWORD=meeting_minutes
POSTGRES_PORT=5432
DATABASE_URL=postgresql://meeting_minutes:meeting_minutes@localhost:5432/meeting_minutes_dev?schema=public
API_PORT=3001

# Independent audio service (never reuse the App database).
AUDIO_PORT=3002
AUDIO_HOST=127.0.0.1
AUDIO_DATABASE_URL=postgresql://meeting_minutes:meeting_minutes@localhost:5432/meeting_minutes_audio?schema=public
# Generate with: openssl rand -hex 32
AUDIO_API_KEY=
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
# Optional override for both models; defaults: Whisper 180s, diarization 600s.
# OPENAI_TIMEOUT_MS=600000
AUDIO_CHUNK_SECONDS=600
AUDIO_OVERLAP_SECONDS=2
AUDIO_FFMPEG_TIMEOUT_MS=180000
AUDIO_PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
