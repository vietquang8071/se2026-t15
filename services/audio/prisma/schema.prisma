generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AudioAsset {
  id            String   @id @default(uuid()) @db.Uuid
  originalName  String
  sourceKey     String
  metadata      Json
  retentionDays Int
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  status        String   @default("uploaded")
  transcript    Json?
  jobs          AudioJob[]

  @@index([expiresAt])
}

model AudioJob {
  id            String   @id @default(uuid()) @db.Uuid
  audioId       String   @db.Uuid
  audio         AudioAsset @relation(fields: [audioId], references: [id], onDelete: Cascade)
  status        String   @default("queued")
  stage         String   @default("queued")
  progress      Int      @default(0)
  attempts      Int      @default(0)
  providerCalls Int      @default(0)
  errorCode     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  checkpoints   Json     @default("{}")

  @@unique([audioId])
  @@index([status, createdAt])
}
