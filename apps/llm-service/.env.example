# ==========================================
# LLM SERVICE - SERVER CONFIGURATION
# ==========================================

# Internal service-to-service authentication
# Generate using: openssl rand -hex 32
LLM_SERVICE_TOKEN=

# HTTP server
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_PORT=8000
LLM_SERVICE_LOG_LEVEL=INFO

# Request limits
# Maximum JSON request size: 10 MiB
LLM_SERVICE_MAX_REQUEST_BYTES=10485760

# Timeout in seconds
LLM_SERVICE_REQUEST_TIMEOUT_SECONDS=180
LLM_SERVICE_PROVIDER_TIMEOUT_SECONDS=60


# ==========================================
# OPENROUTER - LLM PROVIDER
# ==========================================

# Required for live OpenRouter API calls
OPENROUTER_API_KEY=

# OpenRouter API endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used for extraction
# Current repository default: free smoke-test model
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Supported: json_object, text
OPENROUTER_STRUCTURED_OUTPUT_MODE=json_object

# Generation parameters
OPENROUTER_MAX_OUTPUT_TOKENS=2048
OPENROUTER_TEMPERATURE=0

# Require providers to support requested parameters
OPENROUTER_REQUIRE_PARAMETERS=true